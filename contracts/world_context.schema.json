    "object": { "type": "object" },
    "identity": { "type": "object" },
    "organization": { "type": "object" },
    "relations": { "type": "array", "items": { "type": "object" } },
    "currentStates": { "type": "array", "items": { "type": "object" } },
    "recentEvents": { "type": "array", "items": { "type": "object" } },
    "observedFacts": { "type": "array", "items": { "type": "object" } },
    "derivedFacts": { "type": "array", "items": { "type": "object" } },
    "applicableRules": { "type": "array", "items": { "type": "object" } },
    "decisions": { "type": "array", "items": { "type": "object" } },
    "pendingActions": { "type": "array", "items": { "type": "object" } },
    "evidenceSummary": { "type": "object" },
    "asOf": { "type": "string" },
    "traceId": { "type": "string", "minLength": 1 },
