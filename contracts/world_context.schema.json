{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic.local/contracts/world-context/v1",
  "title": "Enterprise Operations World Context",
  "type": "object",
  "required": ["schemaVersion", "object", "identity", "relations", "currentStates", "recentEvents", "observedFacts", "derivedFacts", "decisions", "pendingActions", "evidenceSummary", "traceId", "sourceWrite", "formalPublication"],
