{
  "@context": {
    "ex": "https://semantic.local/ontology/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "prov": "http://www.w3.org/ns/prov#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "canonicalKey": "ex:canonicalKey",
    "displayName": "ex:displayName",
    "sourceSnapshotId": "ex:sourceSnapshotId",
    "sourceRecordId": "ex:sourceRecordId",
    "hasSubject": {"@id": "ex:hasSubject", "@type": "@id"},
    "hasFact": {"@id": "ex:hasFact", "@type": "@id"},
    "hasCurrentState": {"@id": "ex:hasCurrentState", "@type": "@id"}
  }
}
