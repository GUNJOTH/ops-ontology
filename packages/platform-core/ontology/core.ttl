ex:targetKey a owl:DatatypeProperty ; rdfs:domain ex:ActionPlan ; rdfs:range xsd:string .
ex:reason a owl:DatatypeProperty ; rdfs:domain ex:ActionPlan ; rdfs:range xsd:string .
ex:riskLevel a owl:DatatypeProperty ; rdfs:domain ex:ActionPlan ; rdfs:range xsd:string .
ex:requiresApproval a owl:DatatypeProperty ; rdfs:domain ex:ActionPlan ; rdfs:range xsd:boolean .
ex:sourceWrite a owl:DatatypeProperty ; rdfs:domain ex:ActionPlan ; rdfs:range xsd:boolean .
ex:formalPublication a owl:DatatypeProperty ; rdfs:domain ex:ActionPlan ; rdfs:range xsd:boolean .
ex:actionName a owl:DatatypeProperty ; rdfs:domain ex:Action ; rdfs:range xsd:string .
ex:businessMeaning a owl:DatatypeProperty ; rdfs:domain ex:Action ; rdfs:range xsd:string .
ex:actionVersion a owl:DatatypeProperty ; rdfs:domain ex:Action ; rdfs:range xsd:string .
ex:allowedWhenJson a owl:DatatypeProperty ; rdfs:domain ex:Action ; rdfs:range xsd:string .
ex:requiredInputFactsJson a owl:DatatypeProperty ; rdfs:domain ex:Action ; rdfs:range xsd:string .
ex:permissionScopeJson a owl:DatatypeProperty ; rdfs:domain ex:Action ; rdfs:range xsd:string .
ex:adapterMappingsJson a owl:DatatypeProperty ; rdfs:domain ex:Action ; rdfs:range xsd:string .
ex:effectsJson a owl:DatatypeProperty ; rdfs:domain ex:Action ; rdfs:range xsd:string .
ex:executionStatesJson a owl:DatatypeProperty ; rdfs:domain ex:Action ; rdfs:range xsd:string .
ex:packageId a owl:DatatypeProperty ; rdfs:domain ex:KnowledgeAsset ; rdfs:range xsd:string .
ex:knowledgeDomain a owl:DatatypeProperty ; rdfs:domain ex:KnowledgeAsset ; rdfs:range xsd:string .
ex:sourceType a owl:DatatypeProperty ; rdfs:domain ex:KnowledgeAsset ; rdfs:range xsd:string .
ex:sourceId a owl:DatatypeProperty ; rdfs:domain ex:KnowledgeAsset ; rdfs:range xsd:string .
ex:sourceUri a owl:DatatypeProperty ; rdfs:domain ex:KnowledgeAsset ; rdfs:range xsd:anyURI .
