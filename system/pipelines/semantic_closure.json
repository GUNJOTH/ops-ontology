{
  "pipelineId": "semantic-closure",
  "version": "semantic-closure-v2",
  "description": "Local semantic closure with ordered, replayable stages.",
  "steps": [
    {"id": "unified_semantics_layer", "handler": "unified_semantics_layer"},
    {"id": "business_semantics_layer", "handler": "business_semantics_layer", "dependsOn": ["unified_semantics_layer"]},
    {"id": "fact_layer", "handler": "fact_layer", "dependsOn": ["business_semantics_layer"]},
    {"id": "event_projection", "handler": "event_projection", "dependsOn": ["fact_layer"]},
    {"id": "semantic_reasoning", "handler": "semantic_reasoning", "dependsOn": ["fact_layer"]},
    {"id": "defect_status_dictionary", "handler": "defect_status_dictionary", "dependsOn": ["semantic_reasoning"]},
    {"id": "ontology_meta_model", "handler": "ontology_meta_model", "dependsOn": ["event_projection", "semantic_reasoning"]},
    {"id": "runtime_contract", "handler": "runtime_contract", "dependsOn": ["ontology_meta_model"]},
    {"id": "governance_contract", "handler": "governance_contract", "dependsOn": ["runtime_contract"]},
    {"id": "state_replay", "handler": "state_replay", "dependsOn": ["governance_contract", "defect_status_dictionary"]},
    {"id": "fact_builders", "handler": "fact_builders", "dependsOn": ["state_replay"]},
    {"id": "action_catalog", "handler": "action_catalog", "dependsOn": ["fact_builders"]},
    {"id": "decision_action", "handler": "decision_action", "dependsOn": ["action_catalog"]},
    {"id": "execution_ledger", "handler": "execution_ledger", "dependsOn": ["decision_action"]},
    {"id": "canonical_projection", "handler": "canonical_projection", "dependsOn": ["execution_ledger"]},
    {"id": "owl_rl_replay", "handler": "owl_rl_replay", "dependsOn": ["canonical_projection"]},
    {"id": "coverage", "handler": "coverage", "dependsOn": ["owl_rl_replay"]}
  ]
}
