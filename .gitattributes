# Normalize line endings for source and text files.
* text=auto eol=lf

# Explicit binary types.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.pyc binary
*.pyd binary
*.sqlite3 binary
*.sqlite3-wal binary
*.sqlite3-shm binary
*.duckdb binary
*.duckdb.wal binary
*.duckdb.wal.tmp binary
